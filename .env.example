# 阅读次数配置 (默认40次/20分钟)
READ_NUM=40

# 微信读书 curl bash 命令 (必需)
# 获取方式：
# 1. 打开微信读书网页版 https://weread.qq.com/
# 2. 打开浏览器开发者工具 (F12)
# 3. 切换到 Network 标签
# 4. 开始阅读任意书籍
# 5. 找到 'read' 请求，右键选择 "Copy as cURL (bash)"
# 6. 将完整的 curl 命令粘贴到下面
WXREAD_CURL_BASH=curl 'https://weread.qq.com/web/book/read' -H 'accept: application/json, text/plain, */*' -H 'cookie: YOUR_COOKIES_HERE' -H 'user-agent: Mozilla/5.0'

# 推送方式 (可选)
# 支持: pushplus, wxpusher, telegram, serverchan, wecom(企业微信机器人)
PUSH_METHOD=

# PushPlus 推送配置 (可选)
# 官网: https://www.pushplus.plus/
PUSHPLUS_TOKEN=

# Telegram 推送配置 (可选)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WxPusher 推送配置 (可选)
# 官网: https://wxpusher.zjiecode.com/
WXPUSHER_SPT=

# ServerChan 推送配置 (可选)
# 官网: https://sct.ftqq.com/
SERVERCHAN_SPT=

# 企业微信机器人推送配置 (可选)
# 获取方式：企业微信群 -> 右上角 ... -> 群机器人 -> 添加机器人 -> 复制 Webhook 地址
# 填完整地址或只填 key 均可，例如：
#   WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx-xxxx-xxxx
#   WECOM_WEBHOOK=xxxxxxxx-xxxx-xxxx
WECOM_WEBHOOK=
# 消息类型：markdown(默认，标题加粗) 或 text(text 才支持 @ 成员)
WECOM_MSGTYPE=markdown
# 仅 WECOM_MSGTYPE=text 时生效：@all 或成员 userid，多个用逗号分隔
WECOM_MENTIONED=

# 定时任务配置 (Cron 表达式格式)
# 默认每天凌晨1点执行: 0 1 * * *
# 其他示例:
#   每6小时: 0 */6 * * *
#   每天早上8:30: 30 8 * * *
#   每天中午12点: 0 12 * * *
CRON_SCHEDULE=0 1 * * *
